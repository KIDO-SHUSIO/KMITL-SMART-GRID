# Supabase Backend Configuration
VITE_LOCAL_MODE=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API (optional, if using Express instead of Supabase)
VITE_API_URL=

# LINE Official Account (Messaging API) notifications (optional)
# Channel Access Token from LINE Developers Console (Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: User ID or Group ID to send to (leave empty to broadcast to all followers)
LINE_TO_USER_OR_GROUP=
# Cooldown between alerts per room in milliseconds (default: 300000 = 5 minutes)
LINE_COOLDOWN_MS=300000
